XTGBP2 gap gab PBV VDD pfet_03v3 L=0.28u W=4u nf=1  m=1
XMPAN OUTN gan VDD VDD pfet_03v3 L=0.56u W=24u nf=4  m=1
XMPAP OUTP gap VDD VDD pfet_03v3 L=0.56u W=24u nf=4  m=1
