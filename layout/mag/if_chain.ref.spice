XM2 OUTP gn t VSS nfet_03v3 L=0.28u W=40u nf=8  m=1
XMP0N OUTN OUTN VDD VDD pfet_03v3 L=0.56u W=24u nf=4  m=1
XMP0P OUTP OUTP VDD VDD pfet_03v3 L=0.56u W=24u nf=4  m=1
