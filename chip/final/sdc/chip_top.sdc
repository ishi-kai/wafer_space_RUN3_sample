###############################################################################
# Created by write_sdc
###############################################################################
current_design chip_top
###############################################################################
# Timing Constraints
###############################################################################
create_clock -name clk_PAD -period 40.0000 [get_pins {clk_pad/Y}]
set_clock_transition 0.1500 [get_clocks {clk_PAD}]
set_clock_uncertainty 0.2500 clk_PAD
set_propagated_clock [get_clocks {clk_PAD}]
create_clock -name bb_clk -period 488.0000 [get_pins {bb_clk_pad/Y}]
set_clock_transition 0.1500 [get_clocks {bb_clk}]
set_clock_uncertainty 0.2500 bb_clk
set_propagated_clock [get_clocks {bb_clk}]
set_clock_groups -name group1 -asynchronous \
 -group [get_clocks {bb_clk}]\
 -group [get_clocks {clk_PAD}]
set_input_delay 5.0000 -clock [get_clocks {bb_clk}] -min -add_delay [get_ports {bb_ena_PAD}]
set_input_delay 97.6000 -clock [get_clocks {bb_clk}] -max -add_delay [get_ports {bb_ena_PAD}]
set_input_delay 5.0000 -clock [get_clocks {bb_clk}] -min -add_delay [get_ports {bb_rst_n_PAD}]
